    %% =========================================================================
    %% MODEL LAYER (Eloquent Entities)
    %% =========================================================================
    class User {
        <<entity>>
        +bigint user_id PK
        +string name
        +string email
        +string password
        +string role
        +string nik
        +string no_hp
        +text alamat
        +string rt
        +string rw
        +string jenis_kelamin
        +pengajuanSurat() HasMany
        +pengaduan() HasMany
        +pertanyaanUmum() HasMany
        +pendaftaranUmkm() HasMany
        +berita() HasMany
        +umkm() HasMany
        +wisata() HasMany
        +budaya() HasMany
        +galeri() HasMany
        +agendaAcara() HasMany
        +strukturDesa() HasMany
    }

    class JenisSurat {
        <<entity>>
        +bigint id PK
        +string kode_surat
        +string nama_surat
        +text deskripsi
        +json persyaratan
        +string format_nomor
        +boolean is_active
        +pengajuanSurats() HasMany
    }

    class PengajuanSurat {
        <<entity>>
        +bigint pengajuan_surat_id PK
        +string nomor_pengajuan
        +bigint user_id FK
        +bigint jenis_surat_id FK
        +string status
        +text keperluan
        +json data_isian
        +json dokumen_persyaratan
        +string nomor_surat
        +date tanggal_surat
        +text catatan_petugas
        +bigint diproses_oleh FK
        +bigint diverifikasi_oleh FK
        +bigint disetujui_oleh FK
        +string file_surat
        +user() BelongsTo
        +jenisSurat() BelongsTo
        +diprosesBy() BelongsTo
        +diverifikasiBy() BelongsTo
        +disetujuiBy() BelongsTo
        +riwayat() HasMany
    }

    class RiwayatPengajuanSurat {
        <<entity>>
        +bigint id PK
        +bigint pengajuan_surat_id FK
        +bigint user_id FK
        +string status
        +text catatan
        +pengajuanSurat() BelongsTo
        +user() BelongsTo
    }

    class Pengaduan {
        <<entity>>
        +bigint pengaduan_id PK
        +string kode_pengaduan
        +bigint user_id FK
        +string nama_pengadu
        +string email
        +string nomor_telepon
        +string judul
        +text deskripsi
        +string kategori
        +string lokasi
        +string lampiran
        +string status
        +text tanggapan
        +bigint ditanggapi_oleh FK
        +timestamp ditanggapi_pada
        +user() BelongsTo
    }

    class PertanyaanUmum {
        <<entity>>
        +bigint pertanyaan_id PK
        +string kode_pertanyaan
        +bigint user_id FK
        +string nama_penanya
        +string email
        +string nomor_telepon
        +string subjek
        +text pesan
        +string status
        +text jawaban
        +bigint dijawab_oleh FK
        +timestamp dijawab_pada
        +user() BelongsTo
    }

    class PendaftaranUmkm {
        <<entity>>
        +bigint pendaftaran_umkm_id PK
        +string kode_pendaftaran
        +bigint user_id FK
        +string nama_pemilik
        +string nama_usaha
        +string nomor_telepon
        +string email
        +text alamat_usaha
        +string kategori_usaha
        +text deskripsi_usaha
        +string foto_produk
        +string status
        +text catatan
        +bigint disetujui_oleh FK
        +timestamp disetujui_pada
        +user() BelongsTo
        +produkDipublikasikan() HasOne
    }

    class UMKM {
        <<entity>>
        +bigint produk_id PK
        +string nama_usaha
        +string pemilik
        +string jenis_usaha
        +text deskripsi
        +text alamat
        +string kontak
        +string foto
        +string status
        +bigint pendaftaran_umkm_id FK
        +bigint user_id FK
        +user() BelongsTo
        +pendaftaranUmkm() BelongsTo
    }

    class Berita {
        <<entity>>
        +bigint berita_id PK
        +string judul
        +string slug
        +text ringkasan
        +text konten
        +string kategori
        +string gambar
        +boolean is_published
        +int views
        +bigint user_id FK
        +timestamp published_at
        +user() BelongsTo
    }

    class Wisata {
        <<entity>>
        +bigint wisata_id PK
        +string nama
        +string slug
        +text deskripsi
        +text fasilitas
        +string lokasi
        +decimal harga_tiket
        +string jam_operasional
        +string kontak
        +string foto
        +boolean is_active
        +bigint user_id FK
        +user() BelongsTo
    }

    class Budaya {
        <<entity>>
        +bigint budaya_id PK
        +string nama
        +string slug
        +text deskripsi
        +text sejarah
        +string kategori
        +string lokasi
        +string jadwal
        +string foto
        +bigint user_id FK
        +user() BelongsTo
    }

    class Galeri {
        <<entity>>
        +bigint galeri_id PK
        +string judul
        +string slug
        +text deskripsi
        +string kategori
        +string file
        +string tipe
        +boolean is_active
        +bigint user_id FK
        +user() BelongsTo
    }

    class AgendaAcara {
        <<entity>>
        +bigint agenda_acara_id PK
        +string judul
        +string slug
        +text deskripsi
        +string lokasi
        +date tanggal_mulai
        +date tanggal_selesai
        +string waktu
        +string penyelenggara
        +string kontak
        +string foto
        +string status
        +bigint user_id FK
        +user() BelongsTo
    }

    class StrukturDesa {
        <<entity>>
        +bigint struktur_desa_id PK
        +string nama
        +string jabatan
        +string nip
        +int urutan
        +string foto
        +string status
        +date periode_mulai
        +date periode_selesai
        +bigint user_id FK
        +user() BelongsTo
    }

    class Pengaturan {
        <<entity>>
        +bigint pengaturan_id PK
        +string key
        +text value
    }

    class TentangTimeline {
        <<entity>>
        +bigint tentang_timeline_id PK
        +string tahun
        +text peristiwa
    }

    class TentangMisi {
        <<entity>>
        +bigint tentang_misi_id PK
        +text misi
    }

