    %% =========================================================================
    %% MODEL TO MODEL RELATIONS (Eloquent Association)
    %% =========================================================================
    User "1" --> "0..*" PengajuanSurat : user_id
    User "0..1" --> "0..*" PengajuanSurat : diproses_oleh
    User "0..1" --> "0..*" PengajuanSurat : diverifikasi_oleh
    User "0..1" --> "0..*" PengajuanSurat : disetujui_oleh
    JenisSurat "1" --> "0..*" PengajuanSurat : jenis_surat_id
    PengajuanSurat "1" --> "0..*" RiwayatPengajuanSurat : pengajuan_surat_id
    User "1" --> "0..*" RiwayatPengajuanSurat : user_id
    User "1" --> "0..*" Pengaduan : user_id
    User "1" --> "0..*" PertanyaanUmum : user_id
    User "1" --> "0..*" PendaftaranUmkm : user_id
    PendaftaranUmkm "0..1" --> "0..1" UMKM : pendaftaran_umkm_id
    User "1" --> "0..*" UMKM : user_id
    User "1" --> "0..*" Berita : user_id
    User "1" --> "0..*" Wisata : user_id
    User "1" --> "0..*" Budaya : user_id
    User "1" --> "0..*" Galeri : user_id
    User "1" --> "0..*" AgendaAcara : user_id
    User "1" --> "0..*" StrukturDesa : user_id

